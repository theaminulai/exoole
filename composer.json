{
	"name": "exoole/exoole",
	"description": "A custom WordPress plugin for exoole",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"homepage": "https://github.com/theaminuli/exoole",
	"keywords": [
		"exoole",
		"gutenberg",
		"wordpress",
		"editor",
		"wp",
		"react",
		"javascript"
	],
	"scripts": {
		"format": "phpcbf --standard=./phpcs.xml --report-summary --report-source",
		"lint": "phpcs --standard=./phpcs.xml"
	},
	"support": {
		"issues": "https://github.com/theaminuli/exoole/issues"
	},
	"authors": [
		{
			"name": "theaminul",
			"email": "mdaminulislam2015bd@gmail.com"
		},
		{
			"name": "im-azad",
			"email": "im-azad@example.com"
		}
	],
	"autoload": {
		"psr-4": {
			"Exoole\\": "includes/"
		}
	},
	"require-dev": {
		"phpcompatibility/phpcompatibility-wp": "^2.1.3",
		"wp-coding-standards/wpcs": "^3.0",
		"squizlabs/php_codesniffer": "^3.6"
	},
	"require": {
		"composer/installers": "^1.0 || ^2.0"
	},
	"minimum-stability": "alpha",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
