{
	"name": "exoole/exoole",
	"description": "A custom WordPress plugin for exoole",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"homepage": "https://github.com/theaminuli/exoole",
	"keywords": [
		"exoole",
		"gutenberg",
		"wordpress",
		"editor",
		"block",
		"wp",
		"react",
		"javascript"
	],
	"scripts": {
		"format": "phpcbf --standard=./phpcs.xml --report-summary --report-source",
		"lint": "phpcs --standard=./phpcs.xml"
	},
	"support": {
		"issues": "https://github.com/theaminuli/exoole/issues"
	},
	"authors": [
		{
			"name": "Exoole",
			"homepage": "https://github.com/theaminuli/exoole/graphs/contributors"
		}
	],
	"autoload": {
		"psr-4": {
			"Exoole\\": "includes/"
		}
	},
	"minimum-stability": "alpha",
	"prefer-stable": true,
	"config": {
		"process-timeout": 0,
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require": {
		"composer/installers": "^1.0 || ^2.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^0.7",
		"squizlabs/php_codesniffer": "^3.5",
		"phpcompatibility/phpcompatibility-wp": "^2.1.3",
		"wp-coding-standards/wpcs": "^2.2",
		"sirbrillig/phpcs-variable-analysis": "^2.8"
	}
}
