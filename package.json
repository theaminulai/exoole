{
	"name": "exoole",
	"version": "0.1.0",
	"private": true,
	"description": "Create a block-based page Builder Plugin for WordPress.",
	"author": "theaminul",
	"license": "GPL-3.0-or-later",
	"sideEffects": [
		"**/*.scss",
		"**/*.css",
		"packages/*/src/index.ts"
	],
	"keywords": [
		"exoole",
		"block"
	],
	"homepage": "https://wordpress.org/plugins/exoole/",
	"repository": "git+https://github.com/theaminul/exoole.git",
	"bugs": {
		"url": "https://wordpress.org/support/plugin/exoole/"
	},
	"engines": {
		"node": ">=20.10.0",
		"npm": ">=10.2.3"
	},
	"scripts": {
		"build": "wp-scripts build",
		"build:production": "node tools/scripts/build-production.js",
		"dev": "wp-scripts start",
		"dev:hot": "wp-scripts start --hot",
		"create-package": "node tools/scripts/create-package.js",
		"create-block": "node tools/scripts/create-block.js",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:fix": "wp-scripts lint-js --fix && wp-scripts lint-style --fix",
		"lint:md-docs": "wp-scripts lint-md-docs",
		"prepare": "husky install",
		"wp-env": "wp-env",
		"make-pot": "wp i18n make-pot ./ languages/exoole.pot --domain=exoole",
		"format": "wp-scripts format --path=src",
		"lint:standard": "vendor\\bin\\phpcs --standard=phpcs.xml",
		"lint:wpcs": "vendor\\bin\\phpcs --standard=phpcs.xml",
		"lint:wpcs:fix": "vendor\\bin\\phpcbf --standard=phpcs.xml",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"update-version": "node update-version-and-changelog.js",
		"plugin-zip": "wp-scripts plugin-zip",
		"zip": "concurrently \"wp-scripts build\" && composer archive --file=../dist/exoole"
	},
	"workspaces": [
		"packages/*"
	],
	"packageManager": "npm@10.5.0",
	"devDependencies": {
		"@actions/core": "^1.10.0",
		"@types/react": "^18.3.24",
		"@types/prop-types": "^15.7.15",
		"@types/testing-library__jest-dom": "^5.14.9",
		"@types/wordpress__block-editor": "^11.5.17",
		"@types/wordpress__block-library": "^2.6.3",
		"@types/wordpress__editor": "^14.3.1",
		"@types/wordpress__edit-post": "^8.4.2",
		"@types/wordpress__blocks": "^12.5.18",
		"@types/wordpress__date": "^3.3.5",
		"@types/wordpress__keycodes": "^2.3.3",
		"@types/wordpress__media-utils": "^4.14.4",
		"@types/wordpress__rich-text": "^6.4.5",
		"@wordpress/babel-plugin-makepot": "^6.29.0",
		"@wordpress/scripts": "^30.22.0",
		"archiver": "^7.0.1",
		"concurrently": "^9.1.0",
		"husky": "^9.1.5",
		"lerna": "8.1.9",
		"lint-staged": "^15.2.10",
		"npm-check-updates": "^16.14.20",
		"path": "^0.12.7",
		"simple-git": "^3.27.0",
		"typescript-eslint": "^8.43.0",
		"webpack-remove-empty-scripts": "^1.0.4"
	},
	"dependencies": {
		"@codemirror/lang-json": "^6.0.1",
		"@uiw/react-codemirror": "^4.23.1",
		"@wordpress/icons": "^10.29.0",
		"@wordpress/interactivity": "^6.29.0",
		"react-icons": "^5.5.0",
		"react-router": "^7.8.2",
		"react-toastify": "^11.0.5"
	}
}
