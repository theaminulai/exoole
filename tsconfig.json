{
	/**
	 * Exoole Plugin - Root TypeScript Configuration
	 * 
	 * This is the root TypeScript configuration for the Exoole monorepo.
	 * It orchestrates building all packages using TypeScript project references,
	 * following Gutenberg's monorepo architecture pattern.
	 * 
	 * Individual packages extend tsconfig.base.json and define their own
	 * specific configuration in their respective directories.
	 * 
	 * @author Exoole Team
	 */
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"declaration": true,
		"composite": true,
		"declarationMap": false,
		"emitDeclarationOnly": false,
		// "outDir": "./dist"
	},
	"files": [],
	"references": [
		{ "path": "./packages/components" },
		{ "path": "./packages/utils" },
		{ "path": "./packages/hooks" },
		// Add more package references as you create them:
		// { "path": "./packages/data" },
		// { "path": "./packages/editor" },
		// { "path": "./packages/icons" },
		// etc.
	]
}
